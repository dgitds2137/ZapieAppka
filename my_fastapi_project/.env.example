APP_NAME=ZapieApp API
APP_ENV=local

# SQLAlchemy URL for Azure SQL / SQL Server.
# Keep the real value only in .env locally or in Azure App Service App Settings.
MSSQL_CONN_STR="mssql+pyodbc://USER:PASSWORD@SERVER.database.windows.net:1433/DATABASE?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no&loginTimeout=1200"

JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Native Flutter apps do not need CORS, but Flutter Web and browser tools do.
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX="^https?://(localhost|127\.0\.0\.1)(:\d+)?$"
CORS_ALLOW_CREDENTIALS=true

# Set to true in Azure if the app should fail startup when DB schema init fails.
REQUIRE_DATABASE_ON_STARTUP=false

# Google OAuth foundation for frontend -> browser -> callback -> backend exchange.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_DEFAULT_REDIRECT_URI="zapieapp://auth/callback"
GOOGLE_AUTH_ALLOWED_REDIRECT_URIS="zapieapp://auth/callback,http://localhost:3000/auth/callback,http://127.0.0.1:3000/auth/callback"
GOOGLE_AUTH_STATE_TTL_SECONDS=600

# Apple Sign In foundation for frontend -> browser -> callback -> backend exchange.
# APPLE_AUTH_CLIENT_ID should be the Services ID identifier from Apple Developer.
# APPLE_AUTH_PRIVATE_KEY should contain the full .p8 key contents copied into one env var.
APPLE_AUTH_CLIENT_ID=
APPLE_AUTH_TEAM_ID=
APPLE_AUTH_KEY_ID=
APPLE_AUTH_PRIVATE_KEY=
APPLE_AUTH_CALLBACK_BRIDGE_URI="https://api.example.com/apple-auth/return"
APPLE_AUTH_DEFAULT_REDIRECT_URI="zapieapp://auth/callback"
APPLE_AUTH_ALLOWED_REDIRECT_URIS="zapieapp://auth/callback,http://localhost:3000/auth/callback,http://127.0.0.1:3000/auth/callback"
APPLE_AUTH_STATE_TTL_SECONDS=600
